# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build the email-confirmation redirect link. Set to your deployed
# origin in production (e.g. https://app.yourdomain.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only key for the Manager Agent worker (Phase 2). Never expose this
# to the browser and never pass it into an agent's prompt/context.
SUPABASE_SERVICE_ROLE_KEY=

# Powers every Claude-backed agent (Lister/Support in Reselling; Outreach/
# Content/QA/Billing in Agency). Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model the AI-backed agents use (defaults to
# claude-opus-4-8).
CLAUDE_MODEL=

# Optional (Phase 5, Trading). If unset, the Strategy Runner still journals
# trades locally as a paper simulation — Alpaca is an optional real paper
# account behind that, not a hard dependency. Get keys at
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=
# Defaults to https://paper-api.alpaca.markets — do not point this at the
# live-trading endpoint.
ALPACA_BASE_URL=
